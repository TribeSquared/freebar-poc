---
layout: layouts/base.njk
---
{# About section page: coloured title band, About menu on the left, content on the right.
   Governance also has two report downloads and a footnote, each its own editor field. #}
<section class="heading-section text-white text-uppercase {{ hero }}">
  <div class="container">
    <div class="heading-section-content d-sm-flex align-content-sm-end align-items-sm-end justify-content-sm-between">
      <h1>{{ title }}</h1>
    </div>
  </div>
</section>
<section class="about-profile-section">
  <div class="container">
    <article class="row">
      <div class="col-md-auto order-1 order-md-0">
        <aside class="sidebar" aria-label="About FreeBar">
          <ul class="sidebar-nav display-3">
            {%- for item in nav.aboutSidebar %}
            <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {%- endfor %}
          </ul>
        </aside>
      </div>
      <div class="col-md">
        <div class="about-profile-box">
          {{ content | safe }}
          {%- if trustee_report %}
          <p>The latest Trustee report can be downloaded here: <a href="{{ trustee_report }}">{{ trustee_report_label or (trustee_report | filename) }}</a></p>
          {%- endif %}
          {%- if treasurer_report %}
          <p>The latest Treasurer report can be downloaded here: <a href="{{ treasurer_report }}" target="_blank" rel="noopener">{{ treasurer_report_label or (treasurer_report | filename) }}</a></p>
          {%- endif %}
          {%- if note %}
          <p style="font-weight: 400;">{{ note }}</p>
          {%- endif %}
        </div>
      </div>
    </article>
  </div>
</section>
