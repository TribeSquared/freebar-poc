---
layout: base.njk
---
<article class="page">
  <h1>{{ title }}</h1>
  {% if intro %}<p class="intro">{{ intro }}</p>{% endif %}

  {% if report %}
  <a class="download" href="{{ report }}">
    <span class="download__label">{{ report_label or "Download the report" }}</span>
    <span class="download__meta">PDF · {{ report | filename }}</span>
  </a>
  {% endif %}

  <div class="body">
    {{ content | safe }}
  </div>
</article>
